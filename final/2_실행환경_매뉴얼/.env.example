# 제주 같이나들이 환경변수 예시
# 이 파일을 복사해 같은 폴더에 .env 로 저장하고, 값은 각자 발급받아 넣는다.
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env 는 .gitignore 로 막혀 있어 저장소·제출물에 올라가지 않는다. 실제 키를 이 파일에 적지 않는다.

# ---------- 화면 실행에 쓰는 키 ----------

# OpenAI API 키: Agent 대화(말 해석, 도구 선택, 쉬운 설명)
# 발급: https://platform.openai.com/api-keys (유료, 사용 한도 설정 권장)
# 비워 두면 AI 없이 버튼·단어 기반 '기본 모드'로 장소를 추천한다
OPENAI_API_KEY=

# (선택) 사용할 OpenAI 모델. 비워 두면 gpt-5.4-mini
OPENAI_MODEL=

# 카카오 JavaScript 키: 화면 지도(카카오맵)
# 발급: https://developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
#   플랫폼 > Web > 사이트 도메인에 http://localhost:3000 을 등록하고, 카카오맵 사용 설정을 켠다
# 비워 두면 지도 자리에 '카카오맵을 불러오지 못했어요' 안내가 뜬다(추천·대화는 그대로 된다)
KAKAO_JS_KEY=

# 카카오 REST API 키: 식당·병원·약국 전화번호 조회
# 발급: 위와 같은 앱의 REST API 키. 비워 두면 전화번호만 빠진다
KAKAO_REST_KEY=

# ---------- 데이터를 다시 받을 때만 쓰는 키(화면 실행에는 필요 없음) ----------

# 공공데이터포털 한국관광공사 무장애 여행 정보 서비스 키 (scripts/06_fetch_external.py)
# 발급: https://www.data.go.kr 에서 '한국관광공사_무장애 여행 정보' 활용 신청 > 일반 인증키(Decoding)
TOUR_API_KEY=

# 제주데이터허브 프로젝트 키 (scripts/07_hub_api.py: 버스 정류소 기본 정보, 약국 정보)
# 발급: https://www.jejudatahub.net 로그인 > 마이페이지 > 프로젝트 관리 > 프로젝트 만들기
#   프로젝트에 '버스 정류소 기본 정보'와 '약국 정보' 데이터를 담은 뒤 프로젝트 키를 복사한다
JEJU_PROJECT_KEY=
